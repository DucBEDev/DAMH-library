<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white"
    tools:context=".activity.EnterOtpActivity">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xác nhận mã OTP"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <!-- Hướng dẫn -->
    <TextView
        android:id="@+id/tvOtpGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chúng tôi đã gửi mã OTP đến email của bạn.\nVui lòng nhập mã để tiếp tục."
        android:textSize="14sp"
        android:textColor="#8A8A8A"
        android:layout_marginBottom="32dp" />

    <!-- OTP Input (6 ô) - dùng EditText thuần với background bo tròn + stroke -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <EditText
            android:id="@+id/edtOtp1"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:maxLength="1"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/otp_edittext_background"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edtOtp2"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:maxLength="1"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/otp_edittext_background"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edtOtp3"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:maxLength="1"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/otp_edittext_background"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edtOtp4"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:maxLength="1"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/otp_edittext_background"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edtOtp5"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:maxLength="1"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/otp_edittext_background"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edtOtp6"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:maxLength="1"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/otp_edittext_background"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Gửi lại mã -->
    <TextView
        android:id="@+id/tvResendOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gửi lại mã OTP"
        android:textSize="15sp"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="32dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <!-- Nút Xác nhận -->
    <Button
        android:id="@+id/btnVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Xác nhận"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_number_badge"
        android:textColor="@android:color/white"
        android:drawablePadding="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="12dp" />

    <!-- Nút Hủy -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Hủy"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        android:background="@drawable/button_outlined_background"
        android:layout_marginTop="8dp" />

</LinearLayout>