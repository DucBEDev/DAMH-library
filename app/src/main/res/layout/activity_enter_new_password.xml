<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white"
    tools:context=".activity.EnterNewPassword">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đặt lại mật khẩu"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <!-- Hướng dẫn -->
    <TextView
        android:id="@+id/tvGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vui lòng nhập mật khẩu mới cho tài khoản của bạn.\nMật khẩu phải có ít nhất 6 ký tự."
        android:textSize="14sp"
        android:textColor="#8A8A8A"
        android:layout_marginBottom="32dp" />

    <!-- Mật khẩu mới -->
    <EditText
        android:id="@+id/edtNewPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Mật khẩu mới"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="48dp"
        android:background="@drawable/otp_edittext_background"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="12dp"
        android:drawableTint="?attr/colorPrimary"
        android:layout_marginBottom="16dp" />

    <!-- Xác nhận mật khẩu -->
    <EditText
        android:id="@+id/edtConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Xác nhận mật khẩu"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="48dp"
        android:background="@drawable/otp_edittext_background"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="12dp"
        android:drawableTint="?attr/colorPrimary"
        android:layout_marginBottom="40dp" />

    <!-- Nút Xác nhận -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Xác nhận"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_number_badge"
        android:textColor="@android:color/white"
        android:drawablePadding="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="12dp" />

    <!-- Nút Hủy -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Hủy"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        android:background="@drawable/button_outlined_background"
        android:layout_marginTop="8dp" />

</LinearLayout>